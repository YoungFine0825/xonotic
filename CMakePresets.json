{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "msvc-x64",
      "displayName": "MSVC x64 + vcpkg（默认）",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/msvc-x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "msvc-x86",
      "displayName": "MSVC Win32 + vcpkg",
      "generator": "Visual Studio 17 2022",
      "architecture": "Win32",
      "binaryDir": "${sourceDir}/build/msvc-x86",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x86-windows"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux（系统包管理，无需 vcpkg）",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build/linux",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "msys2",
      "displayName": "Windows + MSYS2（MinGW64，用于 q3map2；需设置 MSYS2_ROOT 环境变量）",
      "generator": "MinGW Makefiles",
      "binaryDir": "${sourceDir}/build/msys2",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/source/tools/q3map2/msys2-toolchain.cmake",
        "CMAKE_BUILD_TYPE": "Release",
        "XONOTIC_Q3MAP2_TOOLCHAIN": "msys2",
        "XONOTIC_BUILD_ENGINE": "OFF",
        "XONOTIC_BUILD_GMQCC": "OFF",
        "XONOTIC_BUILD_D0_BLIND_ID": "OFF",
        "XONOTIC_BUILD_GAMECODE": "OFF",
        "XONOTIC_BUILD_Q3MAP2": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "msvc-x64",
      "configurePreset": "msvc-x64",
      "configuration": "Release"
    },
    {
      "name": "msvc-x86",
      "configurePreset": "msvc-x86",
      "configuration": "Release"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "msys2",
      "configurePreset": "msys2"
    }
  ]
}
